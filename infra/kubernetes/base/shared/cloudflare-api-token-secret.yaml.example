# Copy to cloudflare-api-token-secret.yaml, fill api-token, apply.
# Do NOT commit the real token. Token needs Zone:DNS:Edit on rguktong.in.
#
# cert-manager reads this secret from the cert-manager namespace for ClusterIssuer DNS-01.
#
# After secret exists, switch ingress to letsencrypt-prod-dns and force renewal:
#   kubectl apply -f ingress.yaml
#   kubectl delete challenges,orders,certificaterequests -n default --all
#   kubectl delete certificate uniz-tls-cert -n default
#   kubectl get certificate,certificaterequest,order,challenge -n default -w
#
# kubectl apply -f cloudflare-api-token-secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: cloudflare-api-token
  namespace: cert-manager
type: Opaque
stringData:
  api-token: "REPLACE_WITH_CLOUDFLARE_API_TOKEN"
