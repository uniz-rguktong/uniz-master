# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm install --legacy-peer-deps

COPY . .

# Pass build arguments to Vite
ARG VITE_TURNSTILE_SITE_KEY
ARG VITE_API_URL
ARG VITE_CLOUDINARY_CLOUD_NAME
ARG VITE_CLOUDINARY_UPLOAD_PRESET
ARG VITE_ANALYTICS_URL
ARG VITE_ANALYTICS_KEY
ARG VITE_MAINTENANCE_MODE=false
ARG VITE_ENABLE_OUTPASS_OUTING=false

ENV VITE_TURNSTILE_SITE_KEY=$VITE_TURNSTILE_SITE_KEY
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_CLOUDINARY_CLOUD_NAME=$VITE_CLOUDINARY_CLOUD_NAME
ENV VITE_CLOUDINARY_UPLOAD_PRESET=$VITE_CLOUDINARY_UPLOAD_PRESET
ENV VITE_ANALYTICS_URL=$VITE_ANALYTICS_URL
ENV VITE_ANALYTICS_KEY=$VITE_ANALYTICS_KEY
ENV VITE_MAINTENANCE_MODE=$VITE_MAINTENANCE_MODE
ENV VITE_ENABLE_OUTPASS_OUTING=$VITE_ENABLE_OUTPASS_OUTING

# Build the portal
RUN npm run build


# Stage 2: Serve
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
RUN sed -i 's/worker_connections  1024/worker_connections  2048/' /etc/nginx/nginx.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
# Triggering Portal Build - 2026-02-20
 
