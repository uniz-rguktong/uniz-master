{
  "name": "uniz-academics-service",
  "version": "1.0.0",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./createApp": "./dist/createApp.js"
  },
  "scripts": {
    "build": "tsc && (test -d src/generated && cp -r src/generated dist/generated || true)",
    "test": "vitest run --coverage",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "vercel-build": "prisma generate",
    "postinstall": "if [ -f prisma/schema.prisma ]; then npx prisma generate; fi",
    "seed": "ts-node prisma/seed.ts",
    "safe-seed": "ts-node prisma/safe_seed.ts",
    "sample:registration-pdf": "ts-node scripts/generate-registration-pdf-sample.ts",
    "data-reset": "npx prisma db push --force-reset && npm run seed",
    "deploy": "git add . && git commit -m \"deploy: updates\" && git push origin main",
    "redeploy": "bash redeploy.sh"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/ioredis": "^4.28.10",
    "@types/multer": "^2.3.0",
    "@types/nodemailer": "^6.4.24",
    "@uniz/shared": "*",
    "axios": "^1.21.0",
    "bullmq": "^5.81.5",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "form-data": "^4.0.6",
    "helmet": "^7.2.0",
    "ioredis": "5.4.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "multer-storage-cloudinary": "^2.2.1",
    "nodemailer": "^9.1.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/exceljs": "^0.5.3",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "ioredis": "5.4.1",
    "minimatch": "^10.2.3",
    "glob": "^10.3.10"
  }
}
