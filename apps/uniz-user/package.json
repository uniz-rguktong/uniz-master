{
  "name": "uniz-user-service",
  "version": "1.0.0",
  "description": "User Profile microservice for UniZ",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./createApp": "./dist/createApp.js"
  },
  "scripts": {
    "build": "tsc && (test -d src/generated && cp -r src/generated dist/generated || true)",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "vercel-build": "prisma generate",
    "postinstall": "prisma generate",
    "test": "vitest run --coverage",
    "seed": "ts-node prisma/seed.ts",
    "data-reset": "npx prisma db push --force-reset && npm run seed",
    "deploy": "git add . && git commit -m \"deploy: user-service updates\" && git push origin main",
    "redeploy": "bash redeploy.sh"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@prisma/client": "^6.19.3",
    "@types/multer": "^2.3.0",
    "@uniz/shared": "*",
    "axios": "^1.21.0",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "form-data": "^4.0.6",
    "helmet": "^7.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "redis": "^5.12.1",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/exceljs": "^0.5.3",
    "@types/express": "^4.17.25",
    "@types/ioredis": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^10.2.3",
    "glob": "^10.3.10"
  }
}
