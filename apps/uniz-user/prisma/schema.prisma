generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StudentProfile {
  id                   String    @id @default(uuid()) @db.Uuid
  username             String    @unique
  name                 String    @default("")
  email                String    @default("")
  gender               String    @default("")
  phone                String    @default("")
  fatherName           String    @default("")
  motherName           String    @default("")
  fatherOccupation     String    @default("")
  motherOccupation     String    @default("")
  fatherEmail          String    @default("")
  motherEmail          String    @default("")
  fatherAddress        String    @default("")
  motherAddress        String    @default("")
  bloodGroup           String    @default("")
  dateOfBirth          DateTime?
  profileUrl           String    @default("")
  year                 String    @default("")
  semester             String    @default("")
  branch               String    @default("")
  section              String    @default("")
  batch                String    @default("")
  roomno               String    @default("")
  isPresentInCampus    Boolean   @default(true)
  isApplicationPending Boolean   @default(false)
  isSuspended          Boolean   @default(false)
  telegramChatId       String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // New Fields from O21 Allocation Data
  category             String?   @default("")
  campus               String?   @default("")

  // Denormalized Academic Fields for High-Speed Analytics
  cgpa                 Float     @default(0.0)
  totalBacklogs        Int       @default(0)

  @@index([branch, year, batch])
  @@index([cgpa, totalBacklogs])
}

model FacultyProfile {
  id          String   @id @default(uuid()) @db.Uuid
  username    String   @unique
  name        String
  email       String   @unique
  contact     String   @default("")
  department  String
  designation String
  role        String   @default("teacher")
  profileUrl  String   @default("")
  bio         Json?
  isSuspended Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([department])
}

model AdminProfile {
  id          String   @id @default(uuid()) @db.Uuid
  username    String   @unique
  name        String   @default("")
  email       String   @unique @default("")
  contact     String   @default("")
  profileUrl  String   @default("")
  role        String   @default("webadmin")
  designation String   @default("")
  department  String   @default("")
  bio         Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Banner {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  text      String
  imageUrl  String
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PublicNotification {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  content   String
  link      String?
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tender {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  description String
  pdfUrl      String?
  deadline    DateTime?
  isVisible   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model UploadHistory {
  id           String   @id @default(uuid()) @db.Uuid
  type         String // "STUDENTS" | "GRADES" | "ATTENDANCE" | "FACULTY"
  filename     String?
  fileUrl      String? // Added: Link to Cloudinary backup
  totalRows    Int      @default(0)
  successCount Int      @default(0)
  failCount    Int      @default(0)
  errors       Json? // Summary of errors or specific row failures
  status       String   @default("COMPLETED") // "COMPLETED" | "FAILED" | "PARTIAL"
  uploadedBy   String // Username of the webadmin
  createdAt    DateTime @default(now())

  @@index([type])
  @@index([uploadedBy])
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  username  String   // Link to StudentProfile.username, etc.
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([username])
}

/// Campus welfare grievances (moved from uniz-outpass).
model Grievance {
  id           String    @id @default(uuid())
  studentId    String?
  studentEmail String?
  category     String
  description  String
  isAnonymous  Boolean   @default(false)
  status       String    @default("pending")
  resolvedBy   String?
  resolution   String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([status])
  @@index([createdAt])
}

/// Faculty leave (apply, HOD then Dean approval). facultyId = FacultyProfile.id (no FK, legacy id column is TEXT).
model LeaveRequest {
  id         String         @id @default(uuid()) @db.Uuid
  facultyId  String
  username   String
  department String
  leaveType  String
  fromDate   DateTime       @db.Date
  toDate     DateTime       @db.Date
  days       Int
  reason     String
  status     String         @default("pending_hod")
  hodBy      String?
  hodAt      DateTime?
  hodNote    String?
  deanBy     String?
  deanAt     DateTime?
  deanNote   String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([facultyId])
  @@index([status, department])
}

model LeaveBalance {
  id        String         @id @default(uuid()) @db.Uuid
  facultyId String
  year      Int
  leaveType String
  total     Int
  used      Int            @default(0)
  updatedAt DateTime       @updatedAt

  @@unique([facultyId, year, leaveType])
}

model DutyAssignment {
  id         String         @id @default(uuid()) @db.Uuid
  facultyId  String
  department String
  dutyType   String
  title      String
  date       DateTime       @db.Date
  startTime  String?
  endTime    String?
  location   String?
  notes      String?
  assignedBy String
  createdAt  DateTime       @default(now())

  @@index([facultyId, date])
  @@index([department, date])
}

/// Fee structure for a cohort (batch/branch/year filters, empty = all).
model FeeStructure {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  academicYear String
  batch        String   @default("")
  branch       String   @default("")
  year         String   @default("")
  items        Json
  amountPaise  Int
  dueDate      DateTime @db.Date
  active       Boolean  @default(true)
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([academicYear])
}

/// One invoice per student per structure. studentId = StudentProfile.id (text, no FK).
model FeeInvoice {
  id          String   @id @default(uuid()) @db.Uuid
  studentId   String
  username    String
  structureId String   @db.Uuid
  title       String
  amountPaise Int
  paidPaise   Int      @default(0)
  status      String   @default("due")
  dueDate     DateTime @db.Date
  issuedBy    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([username, structureId])
  @@index([status])
  @@index([structureId])
}

/// Payment against an invoice. Only offline receipts for now; online is coming soon.
model Payment {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  username    String
  amountPaise Int
  method      String
  reference   String
  status      String   @default("success")
  recordedBy  String
  createdAt   DateTime @default(now())

  @@unique([method, reference])
  @@index([invoiceId])
  @@index([username])
}

/// Library catalogue title. Copies carry the barcode.
model Book {
  id        String   @id @default(uuid()) @db.Uuid
  isbn      String   @default("")
  title     String
  author    String   @default("")
  publisher String   @default("")
  year      String   @default("")
  category  String   @default("")
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isbn])
  @@index([title])
}

model BookCopy {
  id        String   @id @default(uuid()) @db.Uuid
  bookId    String   @db.Uuid
  barcode   String   @unique
  shelf     String   @default("")
  status    String   @default("available")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookId])
}

/// Borrower is a StudentProfile or FacultyProfile username (text, no FK).
model Loan {
  id               String    @id @default(uuid()) @db.Uuid
  copyId           String    @db.Uuid
  bookId           String    @db.Uuid
  borrowerUsername String
  borrowerType     String
  issuedAt         DateTime  @default(now())
  dueDate          DateTime
  returnedAt       DateTime?
  issuedBy         String
  returnedTo       String?
  remindedAt       DateTime?

  @@index([borrowerUsername])
  @@index([copyId])
  @@index([returnedAt, dueDate])
}

/// Overdue fine. Shown only; paying online is coming soon.
model LibraryFine {
  id          String   @id @default(uuid()) @db.Uuid
  loanId      String   @unique @db.Uuid
  username    String
  amountPaise Int
  status      String   @default("unpaid")
  note        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([username])
  @@index([status])
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  website   String   @default("")
  contact   String   @default("")
  notes     String   @default("")
  createdBy String
  createdAt DateTime @default(now())
}

/// Branches and batches are comma separated; empty means all.
model PlacementDrive {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  title       String
  jobRole     String
  ctcLpa      Float    @default(0)
  location    String   @default("")
  description String   @default("")
  branches    String   @default("")
  batches     String   @default("")
  minCgpa     Float    @default(0)
  maxBacklogs Int      @default(99)
  deadline    DateTime
  status      String   @default("open")
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, deadline])
  @@index([companyId])
}

/// studentId = StudentProfile.id (text, no FK).
model DriveApplication {
  id        String   @id @default(uuid()) @db.Uuid
  driveId   String   @db.Uuid
  studentId String
  username  String
  resumeUrl String   @default("")
  status    String   @default("applied")
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([driveId, username])
  @@index([username])
}

model Offer {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @unique @db.Uuid
  driveId       String   @db.Uuid
  companyId     String   @db.Uuid
  username      String
  ctcLpa        Float    @default(0)
  status        String   @default("offered")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([username])
  @@index([companyId])
}

model AlumniProfile {
  id             String    @id @default(uuid()) @db.Uuid
  username       String    @unique
  studentId      String
  name           String    @default("")
  email          String    @default("")
  branch         String    @default("")
  batch          String    @default("")
  graduationYear Int?
  company        String    @default("")
  jobTitle       String    @default("")
  location       String    @default("")
  linkedinUrl    String    @default("")
  bio            String    @default("")
  visible        Boolean   @default(false)
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([visible])
}

model AlumniJob {
  id          String    @id @default(uuid()) @db.Uuid
  postedBy    String
  company     String
  title       String
  location    String    @default("")
  kind        String    @default("full-time")
  applyUrl    String
  description String    @default("")
  deadline    DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([active])
}
