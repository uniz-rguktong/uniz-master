{
  "name": "uniz-outpass-service",
  "version": "1.0.0",
  "description": "Outpass Workflow microservice for UniZ",
  "main": "dist/index.js",
  "scripts": {
    "test": "TZ=UTC vitest run --coverage",
    "build": "tsc && (test -d src/generated && cp -r src/generated dist/generated || true)",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "vercel-build": "prisma generate",
    "postinstall": "prisma generate",
    "seed": "ts-node prisma/seed.ts",
    "data-reset": "npx prisma migrate reset --force --skip-seed && npx prisma migrate dev --name init_schema && npm run seed",
    "deploy": "git add . && git commit -m \"deploy: outpass-service updates\" && git push origin main",
    "redeploy": "bash redeploy.sh"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@uniz/shared": "*",
    "axios": "^1.21.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.2",
    "helmet": "^7.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^10.2.3",
    "glob": "^10.3.10"
  }
}
