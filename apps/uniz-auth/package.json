{
  "name": "uniz-auth-service",
  "version": "1.0.0",
  "description": "Auth Microservice",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./createApp": "./dist/createApp.js"
  },
  "scripts": {
    "build": "tsc && (test -d src/generated && cp -r src/generated dist/generated || true)",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "prisma:generate": "prisma generate",
    "vercel-build": "prisma generate",
    "postinstall": "if [ -f prisma/schema.prisma ]; then npx prisma generate; fi",
    "seed": "ts-node prisma/seed.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "data-reset": "npx prisma db push --force-reset && npm run seed",
    "deploy": "git add . && git commit -m \"deploy: auth-service updates\" && git push origin main",
    "redeploy": "bash redeploy.sh"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@types/nodemailer": "^6.4.15",
    "@uniz/shared": "*",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.5",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.1.1",
    "tar": "^7.5.22",
    "ua-parser-js": "^2.0.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.0.0",
    "@types/ua-parser-js": "^0.7.39",
    "@vitest/coverage-v8": "^4.1.12",
    "prisma": "^6.4.1",
    "@vitest/coverage-v8": "^4.1.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "minimatch": "^10.2.3",
    "glob": "^10.3.10",
    "tar": "^7.5.22",
    "bcryptjs": "^3.0.3"
  }
}
