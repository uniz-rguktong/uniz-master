{
  "name": "uniz-notification-service",
  "version": "1.1.0",
  "description": "Web push notifications via BullMQ worker",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && bash ../../scripts/copy-prisma-to-dist.sh",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "prisma:generate": "prisma generate",
    "postinstall": "if [ -f prisma/schema.prisma ]; then npx prisma generate; fi",
    "redeploy": "bash redeploy.sh"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "bullmq": "^5.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "web-push": "^3.6.7",
    "zod": "^3.23.8",
    "@prisma/client": "^6.19.2",
    "@uniz/shared": "*"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.4.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  },
  "overrides": {
    "minimatch": "^10.2.3",
    "glob": "^10.3.10"
  }
}
