ARG DEPS_IMAGE=uniz-deps:local
FROM ${DEPS_IMAGE} AS builder

ARG VITE_API_URL=
ARG VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
ARG VITE_MAINTENANCE_MODE=false
ARG VITE_CLOUDINARY_CLOUD_NAME=
ARG VITE_CLOUDINARY_UPLOAD_PRESET=
ARG VITE_ANALYTICS_URL=
ARG VITE_ANALYTICS_KEY=

ENV VITE_API_URL=$VITE_API_URL \
    VITE_TURNSTILE_SITE_KEY=$VITE_TURNSTILE_SITE_KEY \
    VITE_MAINTENANCE_MODE=$VITE_MAINTENANCE_MODE \
    VITE_CLOUDINARY_CLOUD_NAME=$VITE_CLOUDINARY_CLOUD_NAME \
    VITE_CLOUDINARY_UPLOAD_PRESET=$VITE_CLOUDINARY_UPLOAD_PRESET \
    VITE_ANALYTICS_URL=$VITE_ANALYTICS_URL \
    VITE_ANALYTICS_KEY=$VITE_ANALYTICS_KEY

RUN npm install --no-save --ignore-scripts \
      @rollup/rollup-linux-arm64-musl@4.62.2 \
      @rollup/rollup-linux-x64-musl@4.62.2 \
      2>/dev/null || true \
  && npm run build -w uniz

FROM nginx:1.27-alpine
COPY docker/local/portal-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/uniz-portal/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
