# Monorepo service image — build from repo root:
#   docker build -f docker/Dockerfile.service \
#     --build-arg SERVICE_DIR=apps/uniz-auth \
#     --build-arg WORKSPACE_NAME=uniz-auth-service \
#     -t uniz-auth-service:local .
FROM node:20-alpine
ARG SERVICE_DIR=apps/uniz-auth
ARG WORKSPACE_NAME=uniz-auth-service

RUN apk add --no-cache openssl build-base g++ make python3

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages ./packages
COPY apps ./apps

RUN npm ci --ignore-scripts
RUN npm rebuild bcrypt 2>/dev/null || true
RUN npm run build -w @uniz/shared

WORKDIR /app/${SERVICE_DIR}
RUN if [ -f "prisma/schema.prisma" ]; then npx prisma generate; fi
RUN npm run build

WORKDIR /app/${SERVICE_DIR}
CMD ["npm", "start"]
