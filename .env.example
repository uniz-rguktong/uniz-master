# Database
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=uniz_db
POSTGRES_PORT=5432
REDIS_PORT=6379

# Published ports (use WEB_PORT=8081 if 8080 is taken)
WEB_PORT=8080
GATEWAY_PORT=3000

# Security (dev-only defaults — fine for local Docker)
JWT_SECURITY_KEY=local-dev-key-123456
INTERNAL_SECRET=uniz-core
INTERNAL_BOT_SECRET=bot-secret-123

# CORS / browser origins (portal on WEB_PORT)
CLIENT_URL=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173

# Portal build (empty VITE_API_URL = same-origin /api/v1 via nginx)
VITE_API_URL=
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_MAINTENANCE_MODE=false
VITE_ENABLE_OUTPASS_OUTING=false
ENABLE_OUTPASS_OUTING=false
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional integrations (placeholders work for most local flows)
CLOUDINARY_CLOUD_NAME=placeholder
CLOUDINARY_UPLOAD_PRESET=placeholder
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=placeholder
AWS_SECRET_ACCESS_KEY=placeholder
SES_FROM_EMAIL=no-reply@localhost
INSTITUTION_LOGO_URL=https://example.com/logo.png
