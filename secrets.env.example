# UniZ Master Vault Example
# Copy this to secrets.env and fill in the values for local development

# Security
JWT_SECURITY_KEY="local-dev-key-123456"
INTERNAL_SECRET="uniz-core"
INTERNAL_BOT_SECRET="bot-secret-123"

# Infrastructure
REDIS_URL="redis://localhost:6379"

# Databases (Local Docker Compose)
AUTH_DATABASE_URL="postgresql://user:password@localhost:5432/uniz_db?sslmode=disable&schema=uniz_auth"
USER_DATABASE_URL="postgresql://user:password@localhost:5432/uniz_db?sslmode=disable&schema=uniz_user"
ACADEMICS_DATABASE_URL="postgresql://user:password@localhost:5432/uniz_db?sslmode=disable&schema=uniz_academics"
OUTPASS_DATABASE_URL="postgresql://user:password@localhost:5432/uniz_db?sslmode=disable&schema=uniz_outpass"
FILES_DATABASE_URL="postgresql://user:password@localhost:5432/uniz_db?sslmode=disable&schema=uniz_files"
MAIL_DATABASE_URL="postgresql://user:password@localhost:5432/uniz_db?sslmode=disable&schema=uniz_mail"
NOTIFICATION_DATABASE_URL="postgresql://user:password@localhost:5432/uniz_db?sslmode=disable&schema=uniz_notifications"
CRON_DATABASE_URL="postgresql://user:password@localhost:5432/uniz_db?sslmode=disable&schema=uniz_cron"

# External Services (Placeholders)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_UPLOAD_PRESET="your_upload_preset"
# Cloudflare Turnstile (Testing Keys - Always Pass)
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
# Cloudflare DNS API token (prod VPS only — Zone:DNS:Edit for rguktong.in; cert-manager DNS-01)
# CLOUDFLARE_API_TOKEN="your_cloudflare_api_token"
VITE_API_URL="http://localhost:3000/api/v1"
VITE_MAINTENANCE_MODE="false"
VITE_SCRAPER_URL="http://localhost:8080"

# AWS / R2 (Optional for local dev)
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="placeholder"
AWS_SECRET_ACCESS_KEY="placeholder"
SES_FROM_EMAIL="no-reply@localhost"

# Institution
INSTITUTION_LOGO_URL="https://example.com/logo.png"

# Email (SMTP — auth, mail, notifications services)
# EMAIL_USER="noreply@example.com"
# EMAIL_PASS="your_app_password"

# Web Push (notifications service)
# VAPID_PUBLIC_KEY="your_vapid_public_key"
# VAPID_PRIVATE_KEY="your_vapid_private_key"

# Landing site Postgres (production VPS only — uniz-landing-backend)
# LANDING_POSTGRES_USER="landing_user"
# LANDING_POSTGRES_PASSWORD="your_landing_db_password"
# LANDING_POSTGRES_DB="uniz_landing"
# LANDING_DATABASE_URL="postgresql://landing_user:password@localhost:5432/uniz_landing"
# LANDING_JWT_SECURITY_KEY="your_landing_jwt_key"
# LANDING_JWT_ALGORITHM="HS256"
# DUMMY_TOKEN="optional_dev_token"

# Portal build-time analytics (production only)
# VITE_ANALYTICS_URL="https://analytics.example.com"
# VITE_ANALYTICS_API_KEY="your_analytics_key"
# VITE_CLOUDINARY_CLOUD_NAME="your_cloud_name"
# VITE_CLOUDINARY_UPLOAD_PRESET="your_upload_preset"

# Legacy DB aliases (deploy scripts)
# DB_USER="postgres"
# DB_PASS="password"
# DB_HOST="localhost"
# DB_PORT="5432"
# DB_NAME="uniz_db"
# POSTGRES_USER="postgres"
# POSTGRES_PASSWORD="password"

# --- Maintainer / deploy only (not needed for local dev) ---
# VPS_HOST="your.vps.ip.address"
# VPS_USER="root"
# VPS_PASSWORD="your_vps_password"
# VPS_SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"
# GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxx"
# GHCR_PULL_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxx"  # PAT with read:packages — GitHub secret + VPS pull (set via: gh secret set GHCR_PULL_TOKEN)
# GHCR_USERNAME="your-github-username"  # GitHub secret for GHCR docker login on VPS
# INTERNAL_BOT_SECRET is set above for local dev; use a strong value in production
