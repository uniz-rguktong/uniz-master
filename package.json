{
  "name": "uniz-monorepo",
  "version": "1.3.0",
  "private": true,
  "description": "UniZ — npm workspaces monorepo (microservices + portal)",
  "workspaces": [
    "packages/*",
    "apps/uniz-*"
  ],
  "scripts": {
    "deploy": "./scripts/deploy/deploy.sh",
    "build:shared": "npm run build -w @uniz/shared",
    "build:services": "npm run build --workspaces --if-present",
    "ci:build": "npm run build:shared && bash ./scripts/ci/ci-build.sh",
    "install:all": "npm install",
    "setup": "cp secrets.env.example secrets.env && npm run vault:sync",
    "dev": "concurrently -n \"GATEWAY,AUTH,USER,PORTAL\" -c \"cyan,magenta,blue,yellow\" \"npm run dev -w uniz-production-gateway\" \"npm run dev -w uniz-auth-service\" \"npm run dev -w uniz-user-service\" \"npm run dev -w uniz\"",
    "sync:host": "concurrently -n \"GATEWAY,AUTH,USER,PORTAL\" -c \"cyan,magenta,blue,yellow\" \"npm run dev -w uniz-production-gateway\" \"npm run dev -w uniz-auth-service\" \"npm run dev -w uniz-user-service\" \"npm run sync -w uniz\"",
    "dev:all": "concurrently -n \"CORE,ACADEMICS,OUTPASS,FILES,NOTIFY,MAIL,DOCS\" -c \"reset,green,cyan,white,yellow,magenta,blue\" \"npm run dev\" \"npm run dev -w uniz-academics-service\" \"npm run dev -w uniz-outpass-service\" \"npm run dev -w uniz-files-service\" \"npm run dev -w uniz-notification-service\" \"npm run dev -w uniz-mail-service\" \"npm run dev -w uniz-docs\"",
    "dev:cron": "npm run dev -w uniz-cron-service",
    "setup:local": "bash ./scripts/local/setup-local.sh",
    "docker:up": "make up",
    "docker:seed": "make seed",
    "docker:down": "make down",
    "prisma:generate": "bash ./scripts/deploy/prisma-generate-all.sh",
    "setup:quick": "bash ./scripts/local/setup.sh",
    "sync": "bash ./scripts/local/sync-local.sh",
    "seed:local": "ts-node scripts/local/seed-local.ts && cd apps/uniz-academics && DATABASE_URL='postgresql://user:password@127.0.0.1:5432/uniz_db?sslmode=disable&schema=uniz_academics&connection_limit=10' ts-node prisma/safe_seed.ts",
    "prettify": "prettier --write .",
    "vault:get": "bash ./scripts/ops/uniz-vault.sh get",
    "vault:set": "bash ./scripts/ops/uniz-vault.sh set",
    "vault:sync": "bash ./scripts/ops/uniz-vault.sh sync",
    "vault:audit": "bash ./scripts/ops/uniz-vault.sh audit",
    "vault:vps-audit": "bash ./scripts/ops/uniz-vault.sh vps-audit",
    "vault:vps": "bash ./scripts/ops/vps-vault.sh",
    "vault:vps:list": "bash ./scripts/ops/vps-vault.sh list",
    "vault:vps:show": "bash ./scripts/ops/vps-vault.sh show",
    "vault:vps:status": "bash ./scripts/ops/vps-vault.sh status",
    "sem-reg:dry-run": "ts-node scripts/ops/import-sem-reg.ts",
    "sem-reg:import:local": "ts-node scripts/ops/import-sem-reg.ts --apply --approve",
    "watch": "ssh -t -o StrictHostKeyChecking=no root@${VPS_HOST:-76.13.241.174} \"watch -n 1 'kubectl get hpa; echo; kubectl get pods'\"",
    "android:twa:phase-a": "bash apps/uniz-android-twa/phase-a-setup.sh",
    "android:twa:init": "bash apps/uniz-android-twa/init.sh",
    "android:twa:assetlinks": "bash apps/uniz-android-twa/sync-assetlinks.sh",
    "android:twa:verify": "bash apps/uniz-android-twa/verify-assetlinks.sh"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/pg": "^8.18.0",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "colors": "^1.4.0",
    "exceljs": "^4.4.0",
    "form-data": "^4.0.6",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "dotenv": "^17.3.1",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-musl": "4.62.2",
    "@rollup/rollup-linux-x64-gnu": "4.62.2",
    "@rollup/rollup-linux-x64-musl": "4.62.2"
  },
  "overrides": {
    "undici": "^6.22.1",
    "path-to-regexp": "^6.3.0",
    "tar": "^7.5.17",
    "@mapbox/node-pre-gyp": {
      "tar": "^7.5.17"
    },
    "@vercel/node": {
      "path-to-regexp": "^6.3.0"
    },
    "minimatch": "^10.2.3",
    "glob": "^10.3.10",
    "axios": "^1.18.1",
    "form-data": "^4.0.6",
    "follow-redirects": "^1.15.11",
    "uuid": "^11.1.1",
    "bcrypt": "^6.0.0",
    "vite": {
      "esbuild": "^0.28.1"
    },
    "esbuild": "^0.28.1",
    "uniz": {
      "tailwindcss": "3.4.15",
      "@types/react": "18.3.12",
      "@types/react-dom": "18.3.1"
    }
  }
}
